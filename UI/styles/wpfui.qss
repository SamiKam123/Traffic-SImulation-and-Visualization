QWidget#UIMainWindow {
    background: #e9edf6;
    color: #1f2937;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QFrame#m_background_frame {
    background: transparent;
}

QFrame#m_navigation_frame {
    background: #1f2937;
    border-radius: 20px;
    padding: 28px 16px;
    color: #cbd5f5;
}

QLabel#m_nav_title {
    font-size: 18pt;
    font-weight: 600;
    color: #ffffff;
}

QLabel#m_nav_subtitle {
    font-size: 9pt;
    color: #94a3b8;
}

QPushButton#m_nav_home_button,
QPushButton#m_nav_simulation_button,
QPushButton#m_nav_settings_button,
QPushButton#m_nav_about_button,
QPushButton#m_nav_help_button {
    text-align: left;
    padding: 12px 18px;
    border-radius: 12px;
    border: none;
    color: #d7e1fb;
    font-size: 10pt;
    background: transparent;
}

QPushButton#m_nav_home_button:hover,
QPushButton#m_nav_simulation_button:hover,
QPushButton#m_nav_settings_button:hover,
QPushButton#m_nav_about_button:hover,
QPushButton#m_nav_help_button:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

QPushButton#m_nav_home_button:checked,
QPushButton#m_nav_simulation_button:checked,
QPushButton#m_nav_settings_button:checked,
QPushButton#m_nav_about_button:checked,
QPushButton#m_nav_help_button:checked {
    background: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#m_nav_exit_button {
    background: rgba(248, 113, 113, 0.12);
    color: #fca5a5;
    border: none;
    border-radius: 12px;
    padding: 12px 18px;
    text-align: left;
    font-size: 10pt;
}

QPushButton#m_nav_exit_button:hover {
    background: rgba(248, 113, 113, 0.28);
    color: #fee2e2;
}

QFrame#m_content_frame {
    background: #ffffff;
    border-radius: 28px;
    padding: 24px 32px;
}

QFrame#m_header_frame {
    background: transparent;
}

QLabel#m_header_title {
    font-size: 20pt;
    font-weight: 600;
    color: #1f2937;
}

QLabel#m_header_caption {
    font-size: 10pt;
    color: #6b7280;
}

QFrame#m_body_frame {
    background: #f8fafc;
    border-radius: 20px;
    padding: 16px;
}

QStackedWidget#m_stacked_widget,
QWidget#m_first_page,
QWidget#m_about_page,
QWidget#m_help_page,
QWidget#m_setting_page,
QWidget#m_simulation_page {
    background: transparent;
}

QPushButton#m_simulation_play_button,
QPushButton#m_simulation_pause_button,
QPushButton#m_simulation_stop_button,
QPushButton#m_simulation_restart_button {
    background: #2563eb;
    color: #ffffff;
    border-radius: 12px;
    padding: 8px 18px;
    font-weight: 500;
}

QPushButton#m_simulation_play_button:disabled,
QPushButton#m_simulation_pause_button:disabled,
QPushButton#m_simulation_stop_button:disabled,
QPushButton#m_simulation_restart_button:disabled {
    background: #94a3b8;
    color: #e2e8f0;
}

QPushButton#m_simulation_play_button:hover,
QPushButton#m_simulation_pause_button:hover,
QPushButton#m_simulation_stop_button:hover,
QPushButton#m_simulation_restart_button:hover {
    background: #1d4ed8;
}

QFrame#m_simulation_toolbar {
    background: rgba(37, 99, 235, 0.08);
    border-radius: 16px;
    padding: 12px 18px;
}

QGroupBox {
    border: 1px solid rgba(148, 163, 184, 0.4);
    border-radius: 12px;
    margin-top: 20px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px 0 6px;
    color: #2563eb;
}

QLabel {
    font-size: 10pt;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 2px solid #94a3b8;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border-color: #2563eb;
}

QTableWidget,
QTreeWidget,
QListWidget {
    border: 1px solid rgba(148, 163, 184, 0.4);
    border-radius: 12px;
    padding: 8px;
    background: #ffffff;
}

QScrollBar:vertical {
    width: 12px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: rgba(37, 99, 235, 0.4);
    min-height: 48px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 12px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    background: rgba(37, 99, 235, 0.4);
    min-width: 48px;
    border-radius: 6px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
